# Leave empty when using the Vite development proxy (default backend: http://127.0.0.1:8000).
# For a separately hosted backend, set the full origin, e.g. https://sentinel-api.example.com
VITE_API_BASE_URL=

# Optional: change the backend target used by the Vite development proxy.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
